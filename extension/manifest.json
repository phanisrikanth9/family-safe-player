{
  "manifest_version": 3,
  "name": "Family Safe Player",
  "version": "1.0.0",
  "description": "Skips or mutes the scenes you choose on Netflix, Prime Video, Disney+ and YouTube, using skip files you make or mark yourself.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Family Safe Player" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://www.disneyplus.com/*",
    "https://www.youtube.com/*",
    "https://play.max.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.disneyplus.com/*",
        "https://www.youtube.com/*",
        "https://play.max.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
